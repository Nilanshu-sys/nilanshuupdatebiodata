# Next.js client-side Firebase configuration (safe to expose as NEXT_PUBLIC values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of the deployed OTP backend, e.g. https://your-otp-api.example.com
NEXT_PUBLIC_OTP_API_URL=http://localhost:4000

# MSG91 OTP Widget (Widget ID is public; use the token generated under MSG91 Tokens)
NEXT_PUBLIC_MSG91_WIDGET_ID=366a43656134313539333338
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
