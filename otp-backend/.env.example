PORT=4000
# Comma-separated allowed frontend origins; include your exact Netlify site URL
FRONTEND_ORIGIN=http://localhost:3000,https://nilanshubiodata.netlify.app
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/otpdb
OTP_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Server-only MSG91 Auth Key used to verify the widget access token
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RECAPTCHA_SECRET_KEY=
